[Unit]
Description=Telegram Multi-Engine Translation Bot
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/tg_translation_DeepL_bot
EnvironmentFile=/root/tg_translation_DeepL_bot/.env
ExecStart=/root/tg_translation_DeepL_bot/venv/bin/python -m src.main
Restart=always
RestartSec=5s

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tg-translator-bot

[Install]
WantedBy=multi-user.target
