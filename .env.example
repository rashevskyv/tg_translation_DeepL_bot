# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here

# Provider API Keys (Optional defaults - users can set their own keys in bot settings)
DEEPL_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Default Settings
DEFAULT_TARGET_LANGUAGE=English
DEFAULT_PROVIDER=deepl

# Storage
DATABASE_PATH=data/translator.db

# Logging
LOG_LEVEL=INFO
