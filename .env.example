# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here

# Default Fallback API Keys (Optional - users can set their own keys in bot settings)
DEEPL_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
